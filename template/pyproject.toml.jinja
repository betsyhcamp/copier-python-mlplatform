{%- set py_major_minor = python_version.split('.')[:2] | join('.') -%}
{%- set py_target = 'py' + python_version.split('.')[:2] | join('') -%}
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ package_name }}"
version = "0.1.0"
description = ""
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
readme = "README.md"
requires-python = ">={{ py_major_minor }}"
dependencies = [
{%- if project_type == 'pipeline-kfp' %}
    "google-cloud-aiplatform>=1.127.0",
    "google-cloud-storage>=3.6.0",
    "kfp>=2.14.6",
    "pyarrow>=15.0.0",
    "pydantic>=2.0",
    "pyyaml>=6.0.3",
{%- endif %}
]

[dependency-groups]
dev = [
    "ruff",
    "pytest",
    "pre-commit",
    "jupytext",
    "mdformat",
    "mdformat-gfm",
    "pytest-cov",
{%- if project_type in ['package', 'pipeline-kfp'] %}
    "sphinx",
    "furo",
    "sphinx-autodoc-typehints",
    "myst-parser",
{%- endif %}
{%- if project_type == 'pipeline-kfp' %}
    "sqlfluff",
{%- endif %}
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
line-length = 88
target-version = "{{ py_target }}"
extend-exclude = ["*.md", ".venv", "notebooks"]

[tool.ruff.lint]
select = [
    "E4",  # import/syntax-related pycodestyle errors
    "E7",  # statement-level pycodestyle errors
    "E9",  # runtime errors (syntax errors at parse time)
    "F",   # pyflakes — undefined names, unused imports
    "I",   # isort — ruff format does not sort imports
    "UP",  # pyupgrade — modern Python syntax for 3.11+
    "B",   # flake8-bugbear — common design bugs, mutable defaults
]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]

[tool.coverage.run]
source = ["{{ package_name }}"]
branch = true

[tool.coverage.report]
show_missing = true
skip_empty = true
exclude_lines = [
    "pragma: no cover",
    "if TYPE_CHECKING:",
    'if __name__ == "__main__"',
    "raise NotImplementedError",
    "pass",
    "\\.\\.\\.",
    "assert_never",
    "raise AssertionError",
]

[tool.coverage.html]
directory = "htmlcov"
