version: '3'
{% if project_type == 'pipeline-kfp' %}

vars:
  SHA:
    sh: git rev-parse --short HEAD
  DIRTY:
    sh: git diff --quiet || echo "-dirty"
  PROJECT_ID:
    sh: uv run python3 -c "import yaml; print(yaml.safe_load(open('config/config.yaml'))['project_settings']['project_id'])"
  LOCATION:
    sh: uv run python3 -c "import yaml; print(yaml.safe_load(open('config/config.yaml'))['project_settings']['location'])"
  REPO:
    sh: uv run python3 -c "import yaml; print(yaml.safe_load(open('config/config.yaml'))['project_settings']['artifact_registry_repo'])"
  REGISTRY:
    sh: echo "{% raw %}{{.LOCATION}}-docker.pkg.dev/{{.PROJECT_ID}}/{{.REPO}}{% endraw %}"
{% endif %}

tasks:
  # ===========================================
  # DEPENDENCIES
  # ===========================================
  install:
    desc: Install dependencies
    cmds:
      - uv sync

  # ===========================================
  # FILE UTILITIES (delegates to pre-commit)
  # ===========================================
  pre-commit:
    desc: Run pre-commit hooks on all files
    cmds:
      - uv run pre-commit run --all-files

  # ===========================================
  # PROJECT CHECKS (single source of truth)
  # ===========================================
  lint:
    desc: Run ruff linter
    cmds:
      - uv run ruff check .

  lint-fix:
    desc: Run ruff linter with auto-fix
    cmds:
      - uv run ruff check --fix .

  format:
    desc: Format code with ruff
    cmds:
      - uv run ruff format .

  format-check:
    desc: Check code formatting with ruff
    cmds:
      - uv run ruff format --check .

  md-format:
    desc: Format tracked Markdown files with mdformat
    cmds:
      - git ls-files '*.md' | xargs uv run mdformat --wrap keep

  md-check:
    desc: Check tracked Markdown formatting with mdformat
    cmds:
      - git ls-files '*.md' | xargs uv run mdformat --wrap keep --check

  md-format-all:
    desc: Format all Markdown files (tracked and untracked)
    cmds:
      - find . -name '*.md' -not -path './.venv/*' -not -path './.git/*' -not -path './node_modules/*' -not -path './docs/_build/*' | xargs uv run mdformat --wrap keep

  md-check-all:
    desc: Check all Markdown formatting (tracked and untracked)
    cmds:
      - find . -name '*.md' -not -path './.venv/*' -not -path './.git/*' -not -path './node_modules/*' -not -path './docs/_build/*' | xargs uv run mdformat --wrap keep --check

  test:
    desc: Run tests
    cmds:
      - uv run pytest

  test-cov:
    desc: Run tests with coverage report
    cmds:
      - uv run pytest --cov --cov-report=term-missing --cov-report=html

  # ===========================================
  # COMPOSITE TASKS
  # ===========================================
{% if project_type == 'base' %}
  check:
    desc: Run all CI checks
    cmds:
      - task: pre-commit
      - task: test
{% elif project_type == 'package' %}
  check:
    desc: Run all CI checks
    cmds:
      - task: pre-commit
      - task: test
      - task: docs
      - task: build
{% elif project_type == 'pipeline-kfp' %}
  check:
    desc: Run all CI checks
    cmds:
      - task: pre-commit
      - task: test
      - task: docs
{% endif %}
{% if project_type in ['package', 'pipeline-kfp'] %}

  # ===========================================
  # DOCUMENTATION
  # ===========================================
  docs:
    desc: Build HTML documentation locally
    cmds:
      - uv run sphinx-build -b html docs docs/_build/html

  docs-clean:
    desc: Remove built documentation
    cmds:
      - rm -rf docs/_build
{% endif %}
{% if project_type == 'package' %}

  # ===========================================
  # PACKAGE BUILD
  # ===========================================
  build:
    desc: Build the package
    cmds:
      - uv build
{% endif %}
{% if project_type == 'pipeline-kfp' %}

  # ===========================================
  # PIPELINE TASKS
  # ===========================================
  compile:
    desc: Compile pipeline to JSON (placeholder)
    cmds:
      - "echo 'TODO: implement compile'"

  run-local:
    desc: Run pipeline components locally (placeholder)
    cmds:
      - "echo 'TODO: implement run-local'"

  sql-fix:
    desc: Fix SQL formatting in queries/
    cmds:
      - uv run sqlfluff fix queries/

  # ===========================================
  # DOCKER TASKS
  # ===========================================
  build-image:
    desc: Build Docker image tagged with git SHA
    cmds:
      - docker buildx build --platform linux/amd64 -t "{% raw %}{{.REGISTRY}}{% endraw %}/{{ package_name }}:{% raw %}{{.SHA}}{{.DIRTY}}{% endraw %}" .

  verify-image:
    desc: Verify Docker image can import the package
    requires:
      vars: [IMAGE]
    cmds:
      - docker run --rm "{% raw %}{{.IMAGE}}{% endraw %}" python3 -c "import {{ package_name }}"

  push-image:
    desc: Push Docker image to Artifact Registry
    cmds:
      - docker push "{% raw %}{{.REGISTRY}}{% endraw %}/{{ package_name }}:{% raw %}{{.SHA}}{{.DIRTY}}{% endraw %}"

  build-push-image:
    desc: Build, verify, and push Docker image
    vars:
      IMAGE: "{% raw %}{{.REGISTRY}}{% endraw %}/{{ package_name }}:{% raw %}{{.SHA}}{{.DIRTY}}{% endraw %}"
    cmds:
      - task: build-image
      - task: verify-image
        vars:
          IMAGE: "{% raw %}{{.IMAGE}}{% endraw %}"
      - task: push-image
{% endif %}
